# Local development only (wrangler dev reads this automatically; do not commit
# the real file — it is git-ignored). Format mirrors .env.local.
#
# The admin portal (/admin) signs in with the shared passphrase below; the
# Worker signs the session cookie with SESSION_SECRET. Generate secrets with
# `openssl rand -hex 32` (passphrase can be any strong string).
STAFF_PASSPHRASE=dev-only-passphrase
SESSION_SECRET=dev-only-session-secret-replace-in-production

# Optional: custom domain the R2 bucket is served from. When unset, uploads
# return the bare R2 key instead of a full URL.
#IMAGE_PUBLIC_BASE_URL=https://images.hopeinternationalschool.com
